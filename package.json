{
  "name": "@gorth/principle",
  "version": "3.1.5",
  "description": "",
  "type": "module",
  "author": "Gorthenburg",
  "license": "GORTH",
  "private": true,
  "keywords": [
    "gorth",
    "hono",
    "vite",
    "middleware"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goraria/base-principle.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./configs/*": {
      "types": "./dist/configs/*.d.ts",
      "import": "./dist/configs/*.js",
      "require": "./dist/configs/*.cjs"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.js",
      "require": "./dist/modules/*.cjs"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "require": "./dist/lib/*.cjs"
    },
    "./cores/*": {
      "types": "./dist/cores/*.d.ts",
      "import": "./dist/cores/*.js",
      "require": "./dist/cores/*.cjs"
    },
    "./cores/*/*": {
      "types": "./dist/cores/*/*.d.ts",
      "import": "./dist/cores/*/*.js",
      "require": "./dist/cores/*/*.cjs"
    },
    "./cores/*/*/*": {
      "types": "./dist/cores/*/*/*.d.ts",
      "import": "./dist/cores/*/*/*.js",
      "require": "./dist/cores/*/*/*.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "cores/*": [
        "dist/cores/*.d.ts"
      ],
      "cores/*/*": [
        "dist/cores/*/*.d.ts"
      ],
      "lib/*": [
        "dist/lib/*.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --minify",
    "prepack": "pnpm build",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "update": "pnpm update",
    "test": "pnpm build && tsc -p tests/tsconfig.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "hono-rate-limiter": "^0.5.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.4"
}
