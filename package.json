{
  "name": "@gorth-io/principle",
  "version": "0.0.0-alpha.10",
  "description": "Configurable Hono middleware and server integrations for HTTP APIs, JOSE, email, and OTP in the gorth-io ecosystem.",
  "type": "module",
  "author": "Gorthenburg",
  "license": "GORTH",
  "private": false,
  "keywords": [
    "gorth",
    "nitro",
    "hono",
    "vite",
    "middleware",
    "server"
  ],
  "repository": {
    "type": "git",
    "tag": "alpha",
    "url": "git+https://github.com/gorth-io/base-principle.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/modules.md"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./configs/*": {
      "types": "./dist/configs/*.d.ts",
      "import": "./dist/configs/*.js",
      "require": "./dist/configs/*.cjs"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.js",
      "require": "./dist/modules/*.cjs"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "require": "./dist/lib/*.cjs"
    },
    "./cores/*": {
      "types": "./dist/cores/*.d.ts",
      "import": "./dist/cores/*.js",
      "require": "./dist/cores/*.cjs"
    },
    "./cores/*/*": {
      "types": "./dist/cores/*/*.d.ts",
      "import": "./dist/cores/*/*.js",
      "require": "./dist/cores/*/*.cjs"
    },
    "./cores/*/*/*": {
      "types": "./dist/cores/*/*/*.d.ts",
      "import": "./dist/cores/*/*/*.js",
      "require": "./dist/cores/*/*/*.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "cores/*": [
        "dist/cores/*.d.ts"
      ],
      "cores/*/*": [
        "dist/cores/*/*.d.ts"
      ],
      "lib/*": [
        "dist/lib/*.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown --minify",
    "prepack": "bun run build",
    "dev": "tsdown --watch --no-clean",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "update": "bun update",
    "test": "vitest run",
    "test:types": "tsc --project tsconfig.test.json",
    "test:nitro": "node tests/native-nitro.mjs"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.3.3",
    "@hono/node-server": "^2.1.7",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@vercel/otel": "^2.3.0",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.5.0",
    "otplib": "^13.6.0",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "hono": "^4.13.18",
    "hono-openapi": "^1.5.0",
    "hono-rate-limiter": "^0.5.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "prettier": "^3.10.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
